VITE_API_URL=http://localhost:4000/api

# Google Analytics 4 - optional. Analytics only ever sends data in a
# production build (`vite build`) with this set; it's a safe no-op if left
# empty, in dev, or in preview builds without it configured.
VITE_GA_MEASUREMENT_ID=

# Optional. When "true": console-logs every analytics event (any
# environment) and, in production, tags GA4 hits with debug_mode so they
# show up in GA4's DebugView in real time.
VITE_GA_DEBUG=

# Sentry - optional. Error tracking only ever loads the Sentry SDK in a
# production build (`vite build`) with this set; it's a safe no-op if left
# empty, in dev, or in preview builds without it configured. Automatic
# exception/promise-rejection capture and structured console logging work
# regardless of this being set - this only controls whether captured
# errors also get forwarded to Sentry (see src/utils/errorTracking).
VITE_SENTRY_DSN=

# Optional. When "true": console-logs when error tracking initializes
# without a DSN configured.
VITE_SENTRY_DEBUG=
